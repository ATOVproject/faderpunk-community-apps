{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Faderpunk community app manual data",
  "description": "One entry per community app, matching the shape of the official configurator's ManualAppData (configurator/src/components/manual/ManualApp.tsx), minus React-specific typing (ReactNode fields are plain markdown strings here). appId must match the app's entry in apps-catalog.json.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["appId", "title", "description", "icon", "color", "text", "channels"],
    "properties": {
      "appId": {
        "type": "integer",
        "minimum": 100,
        "maximum": 255,
        "description": "Must match the same app's entry in apps-catalog.json."
      },
      "title": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "icon": { "type": "string", "minLength": 1 },
      "color": {
        "type": "string",
        "enum": [
          "White", "Yellow", "Orange", "Red", "Lime", "Green", "Cyan",
          "SkyBlue", "Blue", "Violet", "Pink", "PaleGreen", "Sand", "Rose",
          "Salmon", "LightBlue", "Black", "Custom"
        ]
      },
      "params": { "type": "array", "items": { "type": "string" } },
      "storage": { "type": "array", "items": { "type": "string" } },
      "text": {
        "type": "string",
        "minLength": 1,
        "description": "Markdown body — the main long-form description."
      },
      "channels": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jackTitle", "jackDescription", "faderTitle", "faderDescription", "ledTop", "ledBottom"],
          "properties": {
            "jackTitle": { "type": "string" },
            "jackDescription": { "type": "string" },
            "faderTitle": { "type": "string" },
            "faderDescription": { "type": "string" },
            "faderPlusFnTitle": { "type": "string" },
            "faderPlusFnDescription": { "type": "string" },
            "faderPlusShiftTitle": { "type": "string" },
            "faderPlusShiftDescription": { "type": "string" },
            "fnTitle": { "type": "string" },
            "fnDescription": { "type": "string" },
            "fnPlusShiftTitle": { "type": "string" },
            "fnPlusShiftDescription": { "type": "string" },
            "ledTop": { "type": "string" },
            "ledTopPlusShift": { "type": "string" },
            "ledTopPlusFn": { "type": "string" },
            "ledBottom": { "type": "string" },
            "ledBottomPlusShift": { "type": "string" },
            "ledBottomPlusFn": { "type": "string" }
          }
        }
      }
    }
  }
}
